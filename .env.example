# =========================
# RAG Knowledge QA - 环境变量模板
# =========================
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# .env 文件已被 .gitignore 排除,不会进入版本控制

# ----- PostgreSQL -----
POSTGRES_USER=raguser
POSTGRES_PASSWORD=changeme_pg_pwd
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PASSWORD=changeme_redis_pwd
REDIS_PORT=6379

# ----- Qdrant -----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=          # 可选,留空则不启用鉴权

# ----- LLM Providers -----
# 同时配置多家,运行时按需切换;留空表示不启用
# DeepSeek(中文友好、价格低、OpenAI 兼容协议)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
# 提示：本项目实际用的是阿里云百炼的 OpenAI 兼容接口——key 和 base_url 必须成对。
# 只换 OPENAI_MODEL 却留着 api.openai.com，会拿百炼的 key 去请求 OpenAI（401）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 阿里通义千问(DashScope,OpenAI 兼容)
# 模型选择注意三件事（都踩过）：
#   1) 免费额度按模型各算，换模型=换一份额度
#   2) 跨档位换（plus→max）会移动拒答边界，换完必须跑 scripts/eval_boundary.py
#   3) 思考型模型（qwen3.x-max）流式会多一路 reasoning_content，且吃 max_tokens
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 智谱 GLM(OpenAI 兼容)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ----- Embedding -----
# 项目实际使用 BAAI/bge-m3：1024 维、多语言、2.3GB，本地目录放在 models/bge-m3/
# （ModelScope 下载，见 README 快速开始）。
# 实测（17 道可答题，同一套切分）：中文提问 × 英文语料，纯向量 hit@5 59%→88%。
# 换模型后必须跑 scripts/reindex.py 重建向量（新旧向量不在同一空间）。
# 没有本地模型时会退回 BAAI/bge-small-zh-v1.5（fastembed 自带 ONNX，512 维，
# 冷启动几秒，能跑但跨语言效果差一截）。
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ----- 设备与精度（4GB 显卡的生存配置）-----
# auto / cuda / cpu。bge-m3 与 reranker 都是 568M 参数：
# fp32 各占 2.1GB / 2.3GB，4GB 卡放两个必 OOM（报错在 .to(cuda) 搬权重那一刻，
# 调 batch_size 无效）。开 fp16 后各约 1.15GB，实测峰值 2.12GB / 4.00GB。
# 若显存仍然不够：把 RERANK_DEVICE 设成 cpu，只让 embedding 用显卡。
EMBEDDING_DEVICE=auto
RERANK_DEVICE=auto
GPU_FP16=true

# ----- 应用配置 -----
APP_PORT=8000
LOG_LEVEL=INFO
# ----- 冷启动预热 -----
# 启动时预加载 embedding+reranker 模型，首问检索 ~25s -> <1s。
# 日常开发用 --reload 时建议设 false（改一次代码重启就多等 8 秒）；
# 演示/部署保持 true
WARMUP_ON_START=true

# ----- 知识库主题（注入 prompt 用）-----
# 用来区分"主题内但材料没写"（拒答）和"不属于本库的通用问题"（通用知识回答）。
# 换语料要跟着改，否则模型会拿旧主题做判断。
KB_DESCRIPTION=LangChain 官方文档——如何用 LangChain / Deep Agents 构建 RAG 问答应用
