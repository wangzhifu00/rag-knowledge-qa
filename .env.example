# =========================
# RAG Knowledge QA - 环境变量模板
# =========================
# 复制此文件为 .env 并填入真实值: cp .env.example .env
# .env 文件已被 .gitignore 排除,不会进入版本控制

# ----- PostgreSQL -----
POSTGRES_USER=raguser
POSTGRES_PASSWORD=changeme_pg_pwd
POSTGRES_DB=ragdb
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_PASSWORD=changeme_redis_pwd
REDIS_PORT=6379

# ----- Qdrant -----
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=          # 可选,留空则不启用鉴权

# ----- LLM Providers -----
# 同时配置多家,运行时按需切换;留空表示不启用
# DeepSeek(中文友好、价格低、OpenAI 兼容协议)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 阿里通义千问(DashScope,OpenAI 兼容)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 智谱 GLM(OpenAI 兼容)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ----- Embedding -----
# 默认使用 OpenAI text-embedding-3-small,可换 siliconflow / bge 等
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ----- 应用配置 -----
APP_PORT=8000
LOG_LEVEL=INFO